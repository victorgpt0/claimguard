# Copy to .env and fill in real values. .env is gitignored — never commit it.
# In Colab, prefer google.colab.userdata instead (set once per Google account); this file
# is for local/non-Colab development only.

HF_TOKEN=
OPENAI_API_KEY=

# No WHO ICD-11 API credentials needed: we run whoicd/icd-api locally via
# docker-compose.yml, and local deployments don't use OAuth2 (only the cloud API at
# icd.who.int requires ICD11_CLIENT_ID/ICD11_CLIENT_SECRET). If this project ever
# switches from the local container to the cloud API, add those two vars back here.
