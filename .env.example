# Copy to .env (gitignored, never commit it). Read by the Django settings and docker compose.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Unset: SQLite at web/db.sqlite3. Docker compose sets its own PostgreSQL URL for the web service.
# DATABASE_URL=postgres://claimguard:claimguard-dev@localhost:5432/claimguard
# Hosted (Neon): `neon deploy` writes both URLs here. The app uses the pooled one; run
# migrations on the direct one: DATABASE_URL=$DATABASE_URL_UNPOOLED python manage.py migrate
# DATABASE_URL=postgresql://...@ep-...-pooler....neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://...@ep-....neon.tech/neondb?sslmode=require
POSTGRES_PASSWORD=claimguard-dev
# Hosted (Upstash): rediss://default:<password>@<db>.upstash.io:6379 (TLS, certificate verified)
REDIS_URL=redis://localhost:6379/0
SESSION_TIMEOUT_MINUTES=30
# Sign in with Google (optional). Authorised redirect URI in Google Cloud Console:
#   http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The ML pipeline's config.yaml (paths and thresholds, FR-10)
# CLAIMGUARD_CONFIG=config/config.yaml

# --- The ML code (src/). In Colab, prefer google.colab.userdata instead. ---
HF_TOKEN=
OPENAI_API_KEY=

# No WHO ICD-11 API credentials needed: we run whoicd/icd-api locally via
# docker-compose.yml, and local deployments don't use OAuth2 (only the cloud API at
# icd.who.int requires ICD11_CLIENT_ID/ICD11_CLIENT_SECRET). If this project ever
# switches from the local container to the cloud API, add those two vars back here.
